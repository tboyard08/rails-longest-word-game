<h1>New game</h1>

<div class="letters-container">
  <% @letters.each do |letter| %>
    <div class="letter-card">
      <%= letter %>
    </div>
  <% end %>
</div>

<div class="letters-container">
<form action="/score" data-turbo="false" method="post">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <input id="letters" name="letters" type="hidden" value=<% @letters %> />

  <label for="letters">What is the longest word you can find?</label><br><br>
  <input type="text" id="my_input" name="my_input" autofocus>
  <input type="submit" value="Play">
</form>
